# ------------------------------------------------------------------
# Mock API Studio - backend (NestJS + TypeORM)
#
# This file is committed to git - keep only placeholders in it. Put your real
# values in `.env.local` instead (that file is git-ignored):
#   cp .env.example .env.local        (PowerShell: Copy-Item .env.example .env.local)
# ------------------------------------------------------------------

# Port this server listens on. The Next.js frontend's `next.config.ts`
# rewrites proxy to this same port in development - keep them in sync.
PORT=4000

# Secret used to sign the studio session cookie (HMAC-SHA256). MUST be the
# EXACT same value as the frontend's SESSION_SECRET (in mock-api-studio's own
# .env.local): the frontend verifies the cookie locally (for fast page
# routing, see its src/lib/session.ts) using this same secret, while THIS
# backend is the only one that ever issues/signs it (login/logout). A mismatch
# signs every user out immediately.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# If this is left unset the app falls back to a well-known development secret
# and logs a warning in production - do not ship like that.
SESSION_SECRET=change-me-to-a-long-random-string

# The first studio user. It is created on the very first run, as a row in the
# `studio_users` table. Once that row exists these two values are ignored -
# change passwords from the Users page instead.
ADMIN_USERNAME=era
ADMIN_PASSWORD=Era@1234!!

# ------------------------------------------------------------------
# Database - projects, endpoints, users and logs are all stored in Postgres
# (see src/database/database.config.ts). Two ways to point at one:
# ------------------------------------------------------------------

# DB_ENV=local uses the discrete DB_HOST/DB_PORT/... variables below (a LAN
# or on-prem Postgres). Anything else (including unset) uses a connection
# string instead: DATABASE_URL, then POSTGRES_URL, then PRISMA_DATABASE_URL -
# whichever your host provides (Vercel Postgres/Neon, Supabase, Prisma
# Postgres, RDS, ...).
# DB_ENV=local

# --- local (DB_ENV=local) -------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=mock_api_studio
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false

# --- hosted / live (default) ----------------------------------------------
# Hosted providers need TLS, which is on by default here; append
# `?sslmode=disable` for a plain Postgres without TLS.
DATABASE_URL=postgres://user:password@host:5432/dbname
# POSTGRES_URL=
# PRISMA_DATABASE_URL=

# Optional: put every studio table in its own schema instead of `public` -
# useful when this database is shared with another app.
# DB_SCHEMA=mock_api

# Optional: once the tables exist, set this to 1 to skip the
# CREATE-IF-NOT-EXISTS bootstrap that used to run per Next.js cold start. This
# backend is a long-lived process (that concern doesn't really apply here),
# but the tables are created up front regardless:
#   npm run db:setup     (once, against that database)
# then this can stay off (the default) or be set to 1 either way.
# DB_SCHEMA_READY=1

# Connections per pool. Defaults to 1 if a VERCEL env var is present (this
# backend is not meant to run as short-lived serverless instances, but the
# same caution would apply if it ever does) and 10 otherwise - a long-lived
# server benefits from a bigger pool than the Next.js frontend's used to need.
# DB_POOL_MAX=10

# Query logging (SQL statements to stdout). Noisy - leave off outside debugging.
# DB_LOG=true

# How many request logs are kept. The oldest entries are pruned on every
# write. Default: 500.
# MOCK_LOG_RETENTION=500
